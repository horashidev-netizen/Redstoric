//! # redstoric_common
//!
//! Lõi mô phỏng dùng chung cho **client** và **server** (tương tự crate `common` của Veloren).
//! Crate này không chứa render, cửa sổ hay âm thanh. Mọi thứ ở đây phải chạy được trên
//! server headless và cho cùng một kết quả ở mọi máy.
//!
//! | Module | Nội dung |
//! | --- | --- |
//! | [`block`], [`chunk`] | Loại khối và dữ liệu chunk |
//! | [`generation`], [`worldgen`] | Sinh địa hình, khí hậu, hang động, cây |
//! | [`structures`] | Làng, đấu trường boss |
//! | [`sprites`], [`prop`] | Danh mục sprite và dữ liệu prop |
//! | [`npc`] | Tên, nghề, lời thoại và hàng hoá của dân làng |
//! | [`rules`] | Hằng số cân bằng game (boss, người chơi, giới hạn server) |

pub mod block;
pub mod chunk;
pub mod fauna;
pub mod generation;
pub mod npc;
pub mod prop;
pub mod rules;
pub mod sprites;
pub mod structures;
pub mod worldgen;

pub use block::BlockType;
pub use chunk::{ChunkData, CHUNK_SIZE_X, CHUNK_SIZE_Y, CHUNK_SIZE_Z};
pub use generation::WorldGenerator;
pub use prop::{PropSpawnData, WorldPropKind};

/// Hạt giống thế giới. Server và mọi client phải dùng cùng giá trị để chunk sinh giống nhau.
pub const WORLD_SEED: u32 = 1337;

/// Nửa cạnh thế giới (khối). Thế giới là hình vuông `2 * WORLD_HALF` khối với một hòn đảo
/// ở giữa; ngoài đảo là biển và người chơi bị giữ trong biên (xem `WORLD_LIMIT`).
pub const WORLD_HALF: i32 = 1024;
/// Người chơi không đi xa hơn giá trị này tính từ tâm (chừa một dải biển trong biên).
pub const WORLD_LIMIT: f32 = (WORLD_HALF - 8) as f32;

/// Nửa cạnh thế giới tính theo chunk (số chunk mỗi nửa trục).
pub const WORLD_CHUNKS_HALF: i32 = (WORLD_HALF as usize / CHUNK_SIZE_X) as i32;

/// Chunk `(cx, cz)` có nằm trong hình vuông thế giới không.
#[inline]
pub fn chunk_in_world(cx: i32, cz: i32) -> bool {
    (-WORLD_CHUNKS_HALF..WORLD_CHUNKS_HALF).contains(&cx) && (-WORLD_CHUNKS_HALF..WORLD_CHUNKS_HALF).contains(&cz)
}
