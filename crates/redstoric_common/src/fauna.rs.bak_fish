//! Dữ liệu thuần của động vật hoang dã, mô phỏng theo `common/src/comp/agent.rs` (Psyche, Alignment)
//! và `world/src/layer/wildlife.rs` (gói spawn theo vùng sinh thái + thời điểm trong ngày) của Veloren.
//! Không phụ thuộc ECS/render nên server cũng dùng lại được.
use crate::{WorldGenerator, CHUNK_SIZE_X, CHUNK_SIZE_Z};

/// Loài vật. Tên model nằm ở `assets/placeholders/glb/npc/<loài>/male/`.
#[derive(Clone, Copy, PartialEq, Eq, Debug, Hash)]
pub enum Species {
    Pig,
    Rabbit,
    Deer,
    Wolf,
}

/// Phe của con vật (như `Alignment` của Veloren).
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Alignment {
    /// Thú rừng hiền lành: thấy người là bỏ chạy.
    Wild,
    /// Gia súc quanh làng: không sợ người, quanh quẩn gần nhà.
    Tame,
    /// Thú dữ: thấy người là săn.
    Enemy,
}

/// Tính cách (bản rút gọn của `Psyche` trong Veloren). Khoảng cách tính bằng khối.
#[derive(Clone, Copy, Debug)]
pub struct Psyche {
    /// Máu (tỉ lệ) dưới mức này thì bỏ chạy.
    pub flee_health: f32,
    /// Nhìn thấy người trong tầm này (khi người ở phía trước).
    pub sight_dist: f32,
    /// Nghe thấy người di chuyển trong tầm này, không cần nhìn.
    pub listen_dist: f32,
    /// `None` = đã phát hiện là luôn tấn công (như thú dữ của Veloren).
    pub aggro_dist: Option<f32>,
    /// Hệ số độ lang thang khi rảnh (1.0 = bình thường).
    pub idle_wander_factor: f32,
    /// Nhân với tầm nhìn/nghe.
    pub aggro_range_multiplier: f32,
}

impl Species {
    pub const ALL: [Species; 4] = [Species::Pig, Species::Rabbit, Species::Deer, Species::Wolf];

    pub fn label(self) -> &'static str {
        match self {
            Species::Pig => "Heo",
            Species::Rabbit => "Thỏ",
            Species::Deer => "Hươu",
            Species::Wolf => "Sói",
        }
    }

    pub fn alignment(self) -> Alignment {
        match self {
            Species::Wolf => Alignment::Enemy,
            _ => Alignment::Wild,
        }
    }

    /// Giá trị `flee_health` lấy theo bảng của Veloren.
    pub fn psyche(self) -> Psyche {
        let base = Psyche {
            flee_health: 0.0,
            sight_dist: 40.0,
            listen_dist: 30.0,
            aggro_dist: None,
            idle_wander_factor: 1.0,
            aggro_range_multiplier: 1.0,
        };
        match self {
            Species::Pig => Psyche { flee_health: 0.5, sight_dist: 24.0, listen_dist: 14.0, ..base },
            Species::Rabbit => Psyche { flee_health: 0.25, sight_dist: 28.0, listen_dist: 18.0, idle_wander_factor: 1.4, ..base },
            Species::Deer => Psyche { flee_health: 0.15, sight_dist: 40.0, listen_dist: 26.0, ..base },
            Species::Wolf => Psyche { flee_health: 0.2, sight_dist: 36.0, listen_dist: 24.0, ..base },
        }
    }

    pub fn max_health(self) -> f32 {
        match self {
            Species::Pig => 40.0,
            Species::Rabbit => 15.0,
            Species::Deer => 60.0,
            Species::Wolf => 70.0,
        }
    }

    /// Tốc độ đi bộ và chạy (khối/giây).
    pub fn walk_speed(self) -> f32 {
        match self {
            Species::Pig => 1.6,
            Species::Rabbit => 1.8,
            Species::Deer => 2.2,
            Species::Wolf => 2.6,
        }
    }

    pub fn run_speed(self) -> f32 {
        match self {
            Species::Pig => 5.5,
            Species::Rabbit => 7.5,
            Species::Deer => 9.0,
            Species::Wolf => 8.8,
        }
    }

    /// Hệ số kích thước so với `MODEL_SCALE` của nhân vật.
    pub fn scale(self) -> f32 {
        match self {
            Species::Pig => 1.0,
            Species::Rabbit => 0.9,
            Species::Deer => 1.0,
            Species::Wolf => 1.0,
        }
    }

    /// Nhịp bước chân (như `tempo` trong skeleton attr của Veloren).
    pub fn tempo(self) -> f32 {
        match self {
            Species::Pig => 1.2,
            Species::Rabbit => 1.5,
            Species::Deer => 1.1,
            Species::Wolf => 1.2,
        }
    }

    /// Sát thương một cú cắn (chỉ thú dữ).
    pub fn bite_damage(self) -> f32 {
        match self {
            Species::Wolf => 9.0,
            _ => 0.0,
        }
    }
}

/// Khoảng thời gian trong ngày, trùng `DayPeriod` của Veloren.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum DayPeriod {
    Night,
    Morning,
    Noon,
    Evening,
}

impl DayPeriod {
    pub fn from_hour(h: f32) -> Self {
        match h.rem_euclid(24.0) {
            h if (5.0..11.0).contains(&h) => DayPeriod::Morning,
            h if (11.0..15.0).contains(&h) => DayPeriod::Noon,
            h if (15.0..19.5).contains(&h) => DayPeriod::Evening,
            _ => DayPeriod::Night,
        }
    }
}

use DayPeriod::*;

/// Một gói spawn: loài, trọng số, cỡ bầy, giờ và vùng sinh thái hợp lệ (như `Pack` của Veloren).
pub struct Pack {
    pub species: Species,
    pub weight: u32,
    pub group: (u8, u8),
    pub periods: &'static [DayPeriod],
    pub biomes: &'static [&'static str],
}

pub const PACKS: &[Pack] = &[
    Pack { species: Species::Pig, weight: 3, group: (1, 3), periods: &[Morning, Noon, Evening], biomes: &["Forest", "Savanna"] },
    Pack { species: Species::Rabbit, weight: 4, group: (1, 3), periods: &[Morning, Noon, Evening], biomes: &["Forest", "Savanna", "Taiga"] },
    Pack { species: Species::Deer, weight: 3, group: (2, 4), periods: &[Morning, Noon, Evening], biomes: &["Forest", "Taiga", "Savanna"] },
    Pack { species: Species::Wolf, weight: 2, group: (2, 3), periods: &[Evening, Night], biomes: &["Forest", "Taiga", "Snow Mountains"] },
    Pack { species: Species::Wolf, weight: 1, group: (1, 2), periods: &[Morning, Noon], biomes: &["Taiga", "Snow Mountains"] },
];

/// Xác suất có một bầy ở mỗi chunk, theo vùng sinh thái.
fn density(biome: &str) -> f32 {
    match biome {
        "Forest" => 0.30,
        "Savanna" => 0.22,
        "Taiga" => 0.20,
        "Snow Mountains" => 0.08,
        "Desert" => 0.03,
        _ => 0.0,
    }
}

/// Một con vật sẽ được sinh ra.
#[derive(Clone, Copy, Debug)]
pub struct FaunaSpawn {
    pub species: Species,
    /// Toạ độ thế giới (x, z); độ cao lấy từ địa hình.
    pub x: f32,
    pub z: f32,
    pub seed: u32,
}

#[inline]
pub fn hash32(mut x: u32) -> u32 {
    x ^= x >> 16;
    x = x.wrapping_mul(0x7feb_352d);
    x ^= x >> 15;
    x = x.wrapping_mul(0x846c_a68b);
    x ^ (x >> 16)
}

#[inline]
fn unit(h: u32) -> f32 {
    (h >> 8) as f32 / (1u32 << 24) as f32
}

/// Tâm làng/đấu trường quanh điểm xuất phát được giữ yên tĩnh.
const SAFE_RADIUS: f32 = 60.0;

/// Danh sách con vật của một chunk. Kết quả xác định theo `(seed, cx, cz, period)`.
pub fn chunk_fauna(wg: &WorldGenerator, seed: u32, cx: i32, cz: i32, period: DayPeriod) -> Vec<FaunaSpawn> {
    let base = hash32(seed ^ (cx as u32).wrapping_mul(0x9e37_79b1) ^ (cz as u32).wrapping_mul(0x85eb_ca6b));
    let ox = (cx * CHUNK_SIZE_X as i32) as f32;
    let oz = (cz * CHUNK_SIZE_Z as i32) as f32;
    let (mx, mz) = (ox + CHUNK_SIZE_X as f32 * 0.5, oz + CHUNK_SIZE_Z as f32 * 0.5);
    if (mx * mx + mz * mz).sqrt() < SAFE_RADIUS {
        return Vec::new();
    }
    let biome = wg.biome_label(mx as f64, mz as f64);
    if unit(hash32(base)) >= density(biome) {
        return Vec::new();
    }
    let candidates: Vec<&Pack> = PACKS
        .iter()
        .filter(|p| p.periods.contains(&period) && p.biomes.contains(&biome))
        .collect();
    let total: u32 = candidates.iter().map(|p| p.weight).sum();
    if total == 0 {
        return Vec::new();
    }
    let mut roll = hash32(base ^ 0x51) % total;
    let pack = candidates
        .iter()
        .find(|p| {
            if roll < p.weight {
                true
            } else {
                roll -= p.weight;
                false
            }
        })
        .copied()
        .unwrap_or(candidates[0]);
    let (lo, hi) = pack.group;
    let n = lo as u32 + hash32(base ^ 0x77) % (hi - lo + 1) as u32;

    let mut out = Vec::new();
    for i in 0..n {
        let h = hash32(base ^ 0xa000 ^ i.wrapping_mul(0x1234_5));
        let x = mx + (unit(h) - 0.5) * 10.0;
        let z = mz + (unit(hash32(h)) - 0.5) * 10.0;
        // Chỉ sinh trên đất liền, không xuống nước
        if wg.get_surface_height(x as f64, z as f64) <= wg.sea_level + 1 {
            continue;
        }
        out.push(FaunaSpawn { species: pack.species, x, z, seed: hash32(h ^ 0x9) });
    }
    out
}
