//! Thanh vũ khí ở giữa dưới màn hình: 6 ô tương ứng phím 1–6, ô đang cầm sáng lên.
//! (Chữ không dấu vì font mặc định không có ký tự tiếng Việt.)
use bevy::prelude::*;
use redstoric_core::weapons::{Loadout, WEAPONS};

const LABELS: [&str; 6] = ["Kiem si", "Rieu", "Bua", "Cung thu", "Phap su lua", "Muc su"];

#[derive(Component)]
pub struct HotbarSlot(usize);

pub fn setup_hotbar(mut commands: Commands) {
    commands
        .spawn(Node {
            position_type: PositionType::Absolute,
            bottom: Val::Px(14.0),
            width: Val::Percent(100.0),
            justify_content: JustifyContent::Center,
            ..default()
        })
        .with_children(|row| {
            for (i, def) in WEAPONS.iter().enumerate() {
                let (r, g, b) = def.color;
                row.spawn((
                    Node {
                        width: Val::Px(84.0),
                        height: Val::Px(58.0),
                        margin: UiRect::all(Val::Px(4.0)),
                        flex_direction: FlexDirection::Column,
                        align_items: AlignItems::Center,
                        justify_content: JustifyContent::Center,
                        ..default()
                    },
                    BackgroundColor(Color::srgba(0.05, 0.05, 0.07, 0.75)),
                    HotbarSlot(i),
                ))
                .with_children(|slot| {
                    slot.spawn((
                        Text::new(format!("{}", i + 1)),
                        TextFont { font_size: FontSize::Px(18.0), ..default() },
                        TextColor(Color::srgb(r, g, b)),
                    ));
                    slot.spawn((
                        Text::new(LABELS[i]),
                        TextFont { font_size: FontSize::Px(13.0), ..default() },
                        TextColor(Color::WHITE),
                    ));
                });
            }
        });
}

pub fn update_hotbar(loadout: Res<Loadout>, mut slots: Query<(&HotbarSlot, &mut BackgroundColor)>) {
    if !loadout.is_changed() {
        return;
    }
    for (slot, mut bg) in &mut slots {
        bg.0 = if slot.0 == loadout.selected {
            let (r, g, b) = WEAPONS[slot.0].color;
            Color::srgba(r * 0.55, g * 0.55, b * 0.55, 0.95)
        } else {
            Color::srgba(0.05, 0.05, 0.07, 0.75)
        };
    }
}
