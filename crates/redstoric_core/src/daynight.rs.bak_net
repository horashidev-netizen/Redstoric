//! Chu kỳ ngày đêm: mặt trời/mặt trăng, màu trời, sương mù, ánh sáng môi trường và đèn lồng ban đêm.
//! F8 tua nhanh 1 giờ. `REDSTORIC_HOUR=22` đặt giờ bắt đầu.
use bevy::light::GlobalAmbientLight;
use bevy::prelude::*;
use redstoric_voxel::prop::NightLamp;

/// Giờ trong ngày (0..24) và độ dài một ngày tính bằng giây thực.
#[derive(Resource)]
pub struct TimeOfDay {
    pub hour: f32,
    pub day_length: f32,
}

impl Default for TimeOfDay {
    fn default() -> Self {
        let hour = std::env::var("REDSTORIC_HOUR").ok().and_then(|v| v.parse().ok()).unwrap_or(9.0);
        Self { hour, day_length: 600.0 }
    }
}

/// 0 = ban ngày, 1 = đêm sâu. Hệ thống khác (đèn, NPC...) có thể đọc.
#[derive(Resource, Default)]
pub struct NightFactor(pub f32);

pub struct DayNightPlugin;
impl Plugin for DayNightPlugin {
    fn build(&self, app: &mut App) {
        app.init_resource::<TimeOfDay>()
            .init_resource::<NightFactor>()
            .add_systems(
                Update,
                (advance_time, apply_sky, toggle_lamps)
                    .chain()
                    .run_if(redstoric_voxel::preload::world_ready),
            );
    }
}

fn smooth(e0: f32, e1: f32, x: f32) -> f32 {
    let t = ((x - e0) / (e1 - e0)).clamp(0.0, 1.0);
    t * t * (3.0 - 2.0 * t)
}

fn mix(a: Vec3, b: Vec3, t: f32) -> Vec3 {
    a + (b - a) * t
}

fn advance_time(time: Res<Time>, keys: Res<ButtonInput<KeyCode>>, mut tod: ResMut<TimeOfDay>) {
    let dt = time.delta_secs() / tod.day_length * 24.0;
    tod.hour = (tod.hour + dt).rem_euclid(24.0);
    if keys.just_pressed(KeyCode::F8) {
        tod.hour = (tod.hour + 1.0).rem_euclid(24.0);
        bevy::log::info!("Giờ: {:.0}h", tod.hour);
    }
}

/// Một mốc màu trong ngày (kiểu `sky.glsl` của Veloren: các bảng màu DAWN/DAY/DUSK/NIGHT
/// được nội suy liên tục theo vị trí mặt trời thay vì chuyển cứng).
struct Key {
    h: f32,
    sky: [f32; 3],
    sun: [f32; 3],
    sun_lux: f32,
    amb: [f32; 3],
    amb_b: f32,
}

const KEYS: [Key; 11] = [
    // đêm
    Key { h: 0.0, sky: [0.015, 0.025, 0.06], sun: [0.7, 0.8, 1.0], sun_lux: 0.0, amb: [0.45, 0.55, 1.0], amb_b: 45.0 },
    Key { h: 5.0, sky: [0.02, 0.03, 0.08], sun: [0.7, 0.8, 1.0], sun_lux: 0.0, amb: [0.45, 0.55, 1.0], amb_b: 50.0 },
    // bình minh: trời hồng cam, nắng cam thấp
    Key { h: 5.8, sky: [0.80, 0.42, 0.36], sun: [1.0, 0.55, 0.30], sun_lux: 2500.0, amb: [0.80, 0.65, 0.75], amb_b: 95.0 },
    // sáng
    Key { h: 7.5, sky: [0.60, 0.74, 0.92], sun: [1.0, 0.92, 0.80], sun_lux: 8000.0, amb: [0.85, 0.92, 1.0], amb_b: 160.0 },
    // trưa
    Key { h: 12.0, sky: [0.55, 0.75, 0.97], sun: [1.0, 0.98, 0.95], sun_lux: 11000.0, amb: [0.90, 0.95, 1.0], amb_b: 185.0 },
    // chiều
    Key { h: 15.5, sky: [0.66, 0.76, 0.88], sun: [1.0, 0.90, 0.72], sun_lux: 8500.0, amb: [0.92, 0.92, 0.95], amb_b: 165.0 },
    // chiều muộn: vàng cam
    Key { h: 17.4, sky: [0.92, 0.66, 0.42], sun: [1.0, 0.68, 0.34], sun_lux: 5000.0, amb: [0.95, 0.80, 0.70], amb_b: 125.0 },
    // hoàng hôn: đỏ cam
    Key { h: 18.2, sky: [0.88, 0.32, 0.22], sun: [1.0, 0.45, 0.22], sun_lux: 2200.0, amb: [0.75, 0.55, 0.70], amb_b: 85.0 },
    // chạng vạng: tím xanh
    Key { h: 19.2, sky: [0.14, 0.11, 0.26], sun: [0.7, 0.8, 1.0], sun_lux: 0.0, amb: [0.50, 0.55, 0.95], amb_b: 55.0 },
    // đêm
    Key { h: 20.5, sky: [0.015, 0.025, 0.06], sun: [0.7, 0.8, 1.0], sun_lux: 0.0, amb: [0.45, 0.55, 1.0], amb_b: 45.0 },
    Key { h: 24.0, sky: [0.015, 0.025, 0.06], sun: [0.7, 0.8, 1.0], sun_lux: 0.0, amb: [0.45, 0.55, 1.0], amb_b: 45.0 },
];

fn v3(a: [f32; 3]) -> Vec3 {
    Vec3::from_array(a)
}

/// Nội suy mượt (smoothstep) giữa hai mốc kề nhau.
fn sample(h: f32) -> (Vec3, Vec3, f32, Vec3, f32) {
    let mut i = 0;
    while i + 2 < KEYS.len() && h >= KEYS[i + 1].h {
        i += 1;
    }
    let (a, b) = (&KEYS[i], &KEYS[i + 1]);
    let t = smooth(a.h, b.h, h);
    (
        mix(v3(a.sky), v3(b.sky), t),
        mix(v3(a.sun), v3(b.sun), t),
        a.sun_lux + (b.sun_lux - a.sun_lux) * t,
        mix(v3(a.amb), v3(b.amb), t),
        a.amb_b + (b.amb_b - a.amb_b) * t,
    )
}

fn phase_name(h: f32) -> &'static str {
    match h {
        h if (5.0..7.0).contains(&h) => "Bình minh",
        h if (7.0..11.0).contains(&h) => "Sáng",
        h if (11.0..14.0).contains(&h) => "Trưa",
        h if (14.0..17.0).contains(&h) => "Chiều",
        h if (17.0..19.5).contains(&h) => "Hoàng hôn",
        _ => "Đêm",
    }
}

fn apply_sky(
    tod: Res<TimeOfDay>,
    mut night: ResMut<NightFactor>,
    mut clear: ResMut<ClearColor>,
    mut ambient: ResMut<GlobalAmbientLight>,
    mut suns: Query<(&mut Transform, &mut DirectionalLight)>,
    mut fogs: Query<&mut DistanceFog>,
    weather: Option<Res<crate::weather::Weather>>,
    mut last_phase: Local<&'static str>,
) {
    let h = tod.hour;
    let (sky, sun_col, sun_lux, amb, amb_b) = sample(h);

    let phase = phase_name(h);
    if *last_phase != phase {
        *last_phase = phase;
        bevy::log::info!("{} ({:.0}h)", phase, h);
    }

    // Đèn lồng sáng dần khi độ sáng môi trường giảm
    night.0 = (1.0 - (amb_b - 45.0) / (185.0 - 45.0) * 1.25).clamp(0.0, 1.0);

    // Mưa: trời xám dần, nắng yếu, môi trường tối hơn
    let o = weather.map(|w| w.rain).unwrap_or(0.0);
    let gray = sky.dot(Vec3::new(0.3, 0.59, 0.11));
    let sky = mix(sky, Vec3::splat(gray * 0.8), 0.65 * o);
    let sun_lux = sun_lux * (1.0 - 0.65 * o);
    let amb_b = amb_b * (1.0 - 0.2 * o);

    let sky_c = Color::srgb(sky.x, sky.y, sky.z);
    clear.0 = sky_c;
    for mut fog in &mut fogs {
        fog.color = sky_c;
    }
    ambient.color = Color::srgb(amb.x, amb.y, amb.z);
    ambient.brightness = amb_b;

    // Mặt trời đi từ 5.5h đến 18.5h, mặt trăng phần còn lại. Cả hai đều tắt dần ở chân trời
    // nên lúc đổi nguồn sáng hướng đổ bóng không bị giật.
    let tau = std::f32::consts::PI;
    let (t, lux, color) = if (5.5..18.5).contains(&h) {
        ((h - 5.5) / 13.0, sun_lux, sun_col)
    } else {
        let t = (h - 18.5).rem_euclid(24.0) / 11.0;
        (t, 1500.0 * (t * tau).sin().max(0.0).sqrt(), Vec3::new(0.7, 0.8, 1.0))
    };
    let pitch = -((t * tau).sin() * 1.15).max(0.12);
    let yaw = tau * 0.5 * (1.0 - 2.0 * t) + 0.4;
    for (mut tf, mut light) in &mut suns {
        tf.rotation = Quat::from_rotation_y(yaw) * Quat::from_rotation_x(pitch);
        light.color = Color::srgb(color.x, color.y, color.z);
        light.illuminance = lux;
    }
}

/// Số đèn tối đa bật cùng lúc: bật hết đèn của mọi chunk (hàng trăm PointLight) làm quá tải
/// phân cụm ánh sáng và có thể khiến driver GPU treo (DeviceLost). Chỉ bật đèn gần camera nhất.
const MAX_ACTIVE_LAMPS: usize = 14;
const LAMP_RANGE: f32 = 70.0;

fn toggle_lamps(
    night: Res<NightFactor>,
    cameras: Query<&GlobalTransform, With<Camera3d>>,
    mut lamps: Query<(Entity, &NightLamp, &GlobalTransform, &mut PointLight, &mut Visibility)>,
) {
    let n = night.0;
    let on_night = n > 0.08;
    let cam = cameras.iter().next().map(|t| t.translation());

    // Chọn các đèn gần camera nhất (chỉ khi trời tối)
    let mut chosen: Vec<(f32, Entity)> = Vec::new();
    if on_night {
        if let Some(c) = cam {
            for (e, _, gt, _, _) in lamps.iter() {
                let d = gt.translation().distance_squared(c);
                if d < LAMP_RANGE * LAMP_RANGE {
                    chosen.push((d, e));
                }
            }
            chosen.sort_by(|a, b| a.0.total_cmp(&b.0));
            chosen.truncate(MAX_ACTIVE_LAMPS);
        }
    }

    for (e, lamp, _, mut light, mut vis) in &mut lamps {
        let on = chosen.iter().any(|(_, ce)| *ce == e);
        let v = if on { Visibility::Inherited } else { Visibility::Hidden };
        if *vis != v {
            *vis = v;
        }
        if on {
            light.intensity = lamp.intensity * n;
        }
    }
}
