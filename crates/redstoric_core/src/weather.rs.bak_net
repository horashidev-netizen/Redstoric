//! Thời tiết và mặt nước: mưa rơi quanh camera, trời âm u, gợn sóng lan trên mặt nước (khi mưa
//! rơi xuống hoặc khi người chơi lội/bơi), và đổi màu + trượt normal map của mặt nước theo bầu trời.
//! F6 bật/tắt mưa ngay; `REDSTORIC_RAIN=1` bắt đầu trong cơn mưa.
use bevy::light::NotShadowCaster;
use bevy::math::Affine2;
use bevy::prelude::*;
use redstoric_voxel::{BlockType, VoxelWorldMap, WaterMaterial, WorldGenerator};

use crate::{ActionState, Character};

const DROPS: usize = 420;
/// Bán kính hình trụ mưa quanh camera (khối)
const RAIN_RADIUS: f32 = 20.0;
const RAIN_TOP: f32 = 16.0;
const MAX_RIPPLES: usize = 48;

/// Trạng thái thời tiết. `rain` (0..1) đuổi dần theo `target`, nên mưa đến và tạnh từ từ.
#[derive(Resource)]
pub struct Weather {
    pub rain: f32,
    pub target: f32,
    timer: f32,
    rng: u32,
}

impl Default for Weather {
    fn default() -> Self {
        let raining = std::env::var_os("REDSTORIC_RAIN").is_some();
        Self {
            rain: if raining { 1.0 } else { 0.0 },
            target: if raining { 1.0 } else { 0.0 },
            timer: if raining { 90.0 } else { 150.0 },
            rng: 0x9e37_79b9,
        }
    }
}

#[derive(Component)]
struct RainDrop {
    idx: usize,
    vel: Vec3,
}

#[derive(Component)]
struct Ripple {
    age: f32,
    life: f32,
    size: f32,
}

#[derive(Resource)]
struct RippleMesh(Handle<Mesh>);

#[derive(Resource)]
struct RainAssets {
    mesh: Handle<Mesh>,
    material: Handle<StandardMaterial>,
}

pub struct WeatherPlugin;

impl Plugin for WeatherPlugin {
    fn build(&self, app: &mut App) {
        app.init_resource::<Weather>().add_systems(Startup, setup_weather_assets).add_systems(
            Update,
            (
                weather_schedule,
                spawn_rain_pool,
                rain_system,
                wade_ripples,
                ripple_system,
                water_surface_system,
            )
                .chain()
                .run_if(redstoric_voxel::preload::world_ready),
        );
    }
}

fn rnd(s: &mut u32) -> f32 {
    *s ^= *s << 13;
    *s ^= *s >> 17;
    *s ^= *s << 5;
    (*s >> 8) as f32 / 16_777_216.0
}

fn setup_weather_assets(
    mut commands: Commands,
    mut meshes: ResMut<Assets<Mesh>>,
    mut materials: ResMut<Assets<StandardMaterial>>,
) {
    commands.insert_resource(RippleMesh(meshes.add(Annulus::new(0.40, 0.5))));
    commands.insert_resource(RainAssets {
        mesh: meshes.add(Cuboid::new(0.014, 0.85, 0.014)),
        material: materials.add(StandardMaterial {
            base_color: Color::srgba(0.78, 0.86, 1.0, 0.32),
            unlit: true,
            alpha_mode: AlphaMode::Blend,
            ..default()
        }),
    });
}

/// Mưa tự đến và tạnh theo lịch ngẫu nhiên; F6 đổi trạng thái ngay.
fn weather_schedule(time: Res<Time>, keys: Res<ButtonInput<KeyCode>>, mut w: ResMut<Weather>) {
    let dt = time.delta_secs();
    w.timer -= dt;
    if w.timer <= 0.0 {
        let mut r = w.rng;
        let rain_now = w.target > 0.5;
        // Mưa kéo dài 1–3 phút, trời quang 2–5 phút
        w.timer = if rain_now { 120.0 + rnd(&mut r) * 180.0 } else { 60.0 + rnd(&mut r) * 120.0 };
        w.rng = r;
        w.target = if rain_now { 0.0 } else { 1.0 };
    }
    if keys.just_pressed(KeyCode::F6) {
        w.target = if w.target > 0.5 { 0.0 } else { 1.0 };
        w.timer = 120.0;
        bevy::log::info!("Mưa: {}", if w.target > 0.5 { "bật" } else { "tắt" });
    }
    let target = w.target;
    w.rain += (target - w.rain) * (0.4 * dt).min(1.0);
    if (w.rain - target).abs() < 0.002 {
        w.rain = target;
    }
}

fn spawn_rain_pool(
    mut commands: Commands,
    assets: Option<Res<RainAssets>>,
    cameras: Query<&Transform, With<Camera3d>>,
    mut done: Local<bool>,
) {
    if *done {
        return;
    }
    let (Some(assets), Ok(cam)) = (assets, cameras.single()) else { return; };
    *done = true;
    let mut r = 0x1357_9bdf_u32;
    for idx in 0..DROPS {
        let rel = Vec3::new(
            (rnd(&mut r) * 2.0 - 1.0) * RAIN_RADIUS,
            (rnd(&mut r) * 2.0 - 1.0) * RAIN_TOP,
            (rnd(&mut r) * 2.0 - 1.0) * RAIN_RADIUS,
        );
        let vel = Vec3::new(1.5, -(20.0 + rnd(&mut r) * 6.0), 0.8);
        commands.spawn((
            Mesh3d(assets.mesh.clone()),
            MeshMaterial3d(assets.material.clone()),
            Transform::from_translation(cam.translation + rel)
                .with_rotation(Quat::from_rotation_arc(Vec3::Y, -vel.normalize())),
            Visibility::Hidden,
            NotShadowCaster,
            RainDrop { idx, vel },
        ));
    }
}

fn spawn_ripple(
    commands: &mut Commands,
    mesh: &RippleMesh,
    materials: &mut Assets<StandardMaterial>,
    pos: Vec3,
    size: f32,
) {
    let material = materials.add(StandardMaterial {
        base_color: Color::srgba(1.0, 1.0, 1.0, 0.5),
        unlit: true,
        alpha_mode: AlphaMode::Blend,
        cull_mode: None,
        ..default()
    });
    commands.spawn((
        Mesh3d(mesh.0.clone()),
        MeshMaterial3d(material),
        Transform::from_translation(pos)
            .with_rotation(Quat::from_rotation_x(-std::f32::consts::FRAC_PI_2))
            .with_scale(Vec3::splat(0.2 * size)),
        NotShadowCaster,
        Ripple { age: 0.0, life: 1.1, size },
    ));
}

/// Cao độ mặt nước (khớp `generate_water_mesh`: đỉnh khối nước hạ 0.1, nâng nhẹ để khỏi z-fight).
fn water_surface_y(wg: &WorldGenerator) -> f32 {
    wg.sea_level as f32 + 0.93
}

fn rain_system(
    time: Res<Time>,
    weather: Res<Weather>,
    map: Option<Res<VoxelWorldMap>>,
    wg: Res<WorldGenerator>,
    mut commands: Commands,
    ripple_mesh: Res<RippleMesh>,
    mut materials: ResMut<Assets<StandardMaterial>>,
    ripples: Query<(), With<Ripple>>,
    cameras: Query<&Transform, (With<Camera3d>, Without<RainDrop>)>,
    mut drops: Query<(&mut Transform, &mut Visibility, &RainDrop)>,
    mut rng: Local<u32>,
) {
    if *rng == 0 {
        *rng = 0x2545_f491;
    }
    let Ok(cam) = cameras.single() else { return; };
    let cam = cam.translation;
    let dt = time.delta_secs().min(0.1);
    let shown = (weather.rain * DROPS as f32) as usize;
    let mut ripple_count = ripples.iter().count();
    let surface = water_surface_y(&wg);

    for (mut tf, mut vis, drop) in &mut drops {
        if drop.idx >= shown || weather.rain < 0.02 {
            if *vis != Visibility::Hidden {
                *vis = Visibility::Hidden;
            }
            continue;
        }
        if *vis != Visibility::Inherited {
            *vis = Visibility::Inherited;
        }
        let mut p = tf.translation + drop.vel * dt;
        let rel = p - cam;
        let mut recycle = rel.y < -RAIN_TOP || rel.x.abs() > RAIN_RADIUS || rel.z.abs() > RAIN_RADIUS;
        if !recycle {
            if let Some(b) = map.as_ref().and_then(|m| m.block_at(p.x, p.y, p.z)) {
                if b != BlockType::Air {
                    recycle = true;
                    if b == BlockType::Water && ripple_count < MAX_RIPPLES && rnd(&mut rng) < 0.3 {
                        spawn_ripple(&mut commands, &ripple_mesh, &mut materials, Vec3::new(p.x, surface, p.z), 0.7 + rnd(&mut rng) * 0.5);
                        ripple_count += 1;
                    }
                }
            }
        }
        if recycle {
            p = cam
                + Vec3::new(
                    (rnd(&mut rng) * 2.0 - 1.0) * RAIN_RADIUS,
                    RAIN_TOP * (0.4 + rnd(&mut rng) * 0.6),
                    (rnd(&mut rng) * 2.0 - 1.0) * RAIN_RADIUS,
                );
        }
        tf.translation = p;
    }
}

/// Người chơi lội/bơi trong nước thì sóng lan ra quanh chân.
fn wade_ripples(
    time: Res<Time>,
    map: Option<Res<VoxelWorldMap>>,
    wg: Res<WorldGenerator>,
    mut commands: Commands,
    ripple_mesh: Res<RippleMesh>,
    mut materials: ResMut<Assets<StandardMaterial>>,
    player: Query<(&Transform, &Character)>,
    mut cooldown: Local<f32>,
) {
    *cooldown -= time.delta_secs();
    if *cooldown > 0.0 {
        return;
    }
    let (Some(map), Ok((tf, ch))) = (map, player.single()) else { return; };
    let p = tf.translation;
    if map.block_at(p.x, p.y + 0.3, p.z) != Some(BlockType::Water) {
        return;
    }
    let (size, period) = match ch.state {
        ActionState::Swimming => (1.6, 0.3),
        ActionState::Idle => (1.0, 1.1),
        _ => (1.3, 0.35),
    };
    *cooldown = period;
    spawn_ripple(&mut commands, &ripple_mesh, &mut materials, Vec3::new(p.x, water_surface_y(&wg), p.z), size);
}

fn ripple_system(
    time: Res<Time>,
    mut commands: Commands,
    mut materials: ResMut<Assets<StandardMaterial>>,
    mut ripples: Query<(Entity, &mut Ripple, &mut Transform, &MeshMaterial3d<StandardMaterial>)>,
) {
    let dt = time.delta_secs();
    for (e, mut r, mut tf, mat) in &mut ripples {
        r.age += dt;
        let t = r.age / r.life;
        if t >= 1.0 {
            commands.entity(e).despawn();
            continue;
        }
        tf.scale = Vec3::splat(r.size * (0.25 + t * 1.9));
        if let Some(mut m) = materials.get_mut(&mat.0) {
            m.base_color = Color::srgba(1.0, 1.0, 1.0, (1.0 - t).powf(1.5) * 0.55);
        }
    }
}

/// Mặt nước phản chiếu màu bầu trời, normal map trượt tạo sóng; mưa làm sóng nhanh và đục hơn.
fn water_surface_system(
    time: Res<Time>,
    weather: Res<Weather>,
    clear: Res<ClearColor>,
    water: Option<Res<WaterMaterial>>,
    mut materials: ResMut<Assets<StandardMaterial>>,
) {
    let Some(water) = water else { return; };
    let Some(mut mat) = materials.get_mut(&water.0) else { return; };
    let t = time.elapsed_secs();
    let speed = 1.0 + weather.rain * 1.8;
    mat.uv_transform = Affine2::from_translation(Vec2::new(t * 0.010 * speed, t * 0.006 * speed));
    // Màu và độ trong suốt do màu đỉnh (độ sâu) quyết định; ở đây chỉ pha ánh trời vào
    let sky = clear.0.to_srgba();
    let tint = Vec3::ONE.lerp(Vec3::new(sky.red, sky.green, sky.blue), 0.45) * (1.0 - weather.rain * 0.15);
    mat.base_color = Color::srgba(tint.x, tint.y, tint.z, 1.0);
    mat.perceptual_roughness = 0.04 + weather.rain * 0.18;
}
